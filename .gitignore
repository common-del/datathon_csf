*.pyc
.ipynb_checkpoints/
.DS_Store
Thumbs.db

# Belt and braces: nothing under data/ is ever committed except the placeholder
data/*
!data/primary
data/primary/*
!data/primary/PUT_THE_DATASET_HERE.txt
sandbox_run.log

